{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "recognition/prompts/*.txt", "outDir": "./dist/src" },
      { "include": "recognition/models/*.onnx", "outDir": "./dist/src" }
    ],
    "watchAssets": true
  }
}
