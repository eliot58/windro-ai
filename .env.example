# Приложение
NODE_ENV=development
PORT=3000
PUBLIC_URL=https://api.example.com
# Ключ для заголовка x-api-key: openssl rand -hex 32
API_KEY=

# База данных
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/windro

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Если сервер не достаёт до Telegram напрямую
# TELEGRAM_PROXY_URL=http://user:password@host:port

# Модель распознавания (OpenRouter)
LLM_API_KEY=
# Если OpenRouter блокирует IP сервера
# LLM_PROXY_URL=http://user:password@host:port
# LLM_DOCUMENT_MODEL=google/gemini-3-flash-preview
# LLM_PHOTO_MODEL=google/gemini-3.5-flash
# LLM_FALLBACK_MODEL=google/gemini-3.1-pro-preview

# Сервер коммерческих предложений
PROPOSAL_SERVER_URL=http://176.62.187.250:8035
